# CityWalk 远端部署环境变量
# 复制此文件为 .env 并填入实际值: cp .env.deploy .env

# MongoDB配置（容器内网络，无需修改）
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=citywalk

# LLM配置
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# FalkorDB配置
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=citywalk_kg

# 高德地图API
AMAP_API_KEY_BACKEND=your-backend-key
AMAP_API_KEY=your-web-key
AMAP_SECURITY_KEY=your-security-key

# 应用配置
APP_NAME=CityWalk
APP_VERSION=1.0.0
DEBUG=false
